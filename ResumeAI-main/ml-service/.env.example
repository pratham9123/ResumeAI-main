# ML Service – copy this to .env and fill in your values
# python -m venv venv && venv\Scripts\activate && pip install -r requirements.txt

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_MS=60000
OPENAI_TIMEOUT_MS=60000

# Set to "0" on Render free tier (512MB RAM) to disable sentence-transformers
# and use lightweight TF-IDF instead (saves ~300MB RAM, prevents OOM crashes)
# Set to "1" (default) on paid plans for better semantic similarity accuracy
SEMANTIC_MODEL_SHARED=0

# Optional RAG feedback enrichment. Deterministic scoring is unchanged.
RAG_ENABLED=false
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25
RAG_INDEX_PATH=knowledge_base/index
RAG_METADATA_PATH=knowledge_base/index/chunks.json
RAG_MODEL_NAME=all-MiniLM-L6-v2
RAG_DEBUG=false
RAG_CACHE_SIZE=128
RAG_CACHE_TTL_SECONDS=300

# Flask request limits. Full retrieved guidance is never returned unless debug is enabled.
MAX_RESUME_BYTES=5242880
MAX_REQUEST_BYTES=6291456
MAX_JOB_DESCRIPTION_CHARS=50000


# Optional – only needed if running directly with python app.py
# PORT=8000
# FLASK_DEBUG=false
